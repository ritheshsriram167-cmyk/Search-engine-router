# Server Port (Render sets PORT automatically)
PORT=3000

# Supabase Credentials (Project Settings -> API in Supabase dashboard)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key

# Optional: Default fallback Gemini Key if database pool is empty
# FALLBACK_GEMINI_KEY=
